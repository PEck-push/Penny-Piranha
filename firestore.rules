rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin-Erkennung ───────────────────────────────────────────────────────
    // Spiegelt die Server-Logik (netlify/functions/_lib/adminAuth.ts):
    //   1. Bekannte Admin-E-Mails (Fallback-Liste, identisch zum Server).
    //   2. ODER ein Spieler-Dokument mit isAdmin == true (z. B. Michael nach
    //      prepare-go-live). So funktionieren Admin-Schreibzugriffe auch für
    //      Admins, deren E-Mail (noch) nicht in der Liste steht.
    // get() läuft nur, wenn die E-Mail-Prüfung fehlschlägt (Short-Circuit), und
    // in den meisten Regeln steht der eigene-Doc-Pfad davor — Admin-Reads fallen
    // daher nur bei echten Admin-Aktionen an (selten).
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null
          && request.auth.token.email.lower() in ['marketing@gwt.at', 'philipp_eckhardt@live.de'])
        || (exists(/databases/$(database)/documents/players/$(request.auth.uid))
            && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    // ── Players ─────────────────────────────────────────────────────────────
    // Schreibrechte sind mehrfach beschränkt:
    //   1. CREATE: nur die eigene Doc, und nur mit sicheren Startwerten
    //      (Tokens == 1000, kein Self-Admin, keine Selbst-Freigabe, kein
    //      Test-Spieler-Flag, leere Streaks/Inventar). Damit kann sich niemand
    //      per Hand-Request ein Millionen-Konto oder Admin-Rechte anlegen.
    //   2. UPDATE: „Schutzfelder" (Tokens, Streaks, Shop-Bestand, Freigabe,
    //      Admin-Flag …) dürfen NICHT direkt vom Client geschrieben werden — die
    //      setzen ausschliesslich die Netlify-Functions via Admin-SDK (place-bet,
    //      change-bet, purchase-shop-item, buyback, resolve-market, tick,
    //      go-live). Admins dürfen zusätzlich Freigabe/Promotion/Charakter-Reset
    //      anderer Spieler vornehmen (aber keine Tokens — die laufen über
    //      admin-grant). Test-Spieler verwaltet ausschliesslich der Admin.
    match /players/{playerId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        // Selbst-Registrierung: nur ueber eigene UID. Die ehemals strikte
        // Feld-Validierung (tokens==1000 etc.) ist entfernt, weil sie im
        // Praxis-Einsatz die Registrierung blockiert hat. Schutz gegen
        // Self-Token-Manipulation laeuft jetzt ausschliesslich ueber die
        // UPDATE-Schutzfelder unten (tokens, isAdmin, approved … nur
        // server-seitig schreibbar). Ein boeswilliger User koennte sich
        // mit tokens=1000000 selbst registrieren — bei 40 Trusted Friends
        // ist das Risiko vernachlaessigbar, der Admin sieht den Wert in
        // der Rangliste sofort und kann den User loeschen.
        request.auth.uid == playerId
        // Admin legt Test-Spieler an (Pool-Simulation im Testmodus).
        || (isAdmin() && request.resource.data.isTestPlayer == true)
      );

      allow update: if request.auth != null && (
        // 1. Eigene Doc: alles ausser Schutzfeldern. dailyNetGain +
        //    unseenResolutions sind bewusst NICHT geschützt — RevealScreen und
        //    simulateReveal müssen sie für den eigenen User setzen können.
        (request.auth.uid == playerId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'tokens', 'isAdmin', 'approved', 'buybackUsed',
              'shopInventory',
              'currentStreak', 'bestStreak', 'streakLevel', 'streakHistory',
              'unlockedOverlays', 'austriaSpecialCorrect', 'underdogCorrect',
              'badges', 'isTestPlayer'
            ]))
        // 2. Admin verwaltet Test-Spieler: volle Kontrolle (Pool-Simulation).
        || (resource.data.isTestPlayer == true && isAdmin())
        // 3. Admin verwaltet echte Spieler: Freigabe (approved), Promotion
        //    (isAdmin) und Charakter-Reset — aber Tokens & Spielstand bleiben
        //    server-seitig (admin-grant / resolve-market).
        || (isAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'tokens', 'buybackUsed', 'shopInventory',
                'currentStreak', 'bestStreak', 'streakLevel', 'streakHistory',
                'unlockedOverlays', 'austriaSpecialCorrect', 'underdogCorrect', 'badges'
              ]))
      );

      allow delete: if request.auth != null && (
        request.auth.uid == playerId
        || (resource.data.isTestPlayer == true && isAdmin())
      );
    }

    // ── Usernames: Namens-Reservierung ────────────────────────────────────────
    // Reservierung zeigt immer auf den eigenen Account; löschen darf nur der
    // Eigentümer (oder ein Admin). Bulk-Cleanup beim Reset macht die Netlify-
    // Function go-live via Admin-SDK (umgeht die Rules).
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── Markets ───────────────────────────────────────────────────────────────
    // Lesen für alle authed. Schreiben NUR für Admins (Markt anlegen, sperren,
    // pausieren, öffnen, löschen im Admin-Panel). Die automatische Markt-Öffnung
    // und das Kickoff-Locking laufen server-seitig (tick.ts via Admin-SDK), die
    // Pool-Fortschreibung über place-bet — beide umgehen die Rules. Damit kann
    // kein Spieler mehr Pools, Status, Sieger oder Anstosszeit manipulieren.
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Bets ─────────────────────────────────────────────────────────────────
    // Lesen für jeden authed. Schreiben NUR über Server-Endpoints
    // (place-bet, change-bet, resolve-market). Damit kann sich kein Spieler
    // einen Pool oder Payout-Eintrag erfinden.
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Answers ──────────────────────────────────────────────────────────────
    // Offene Antworten („Wer schiesst?"): Spieler dürfen ihre eigene Antwort
    // anlegen; Bulk-Delete beim Reset macht die Netlify-Function go-live.
    match /answers/{answerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.playerId == request.auth.uid;
      allow delete: if false;
      allow update: if false;
    }

    // ── App state ────────────────────────────────────────────────────────────
    // Invite-Code öffentlich lesbar (Registrier-Gate). Admins dürfen alles
    // schreiben (adminMessage, exchangeRate, whatsappGroupLink, Shop-Drop-Ts,
    // Jackpot-Override). Nicht-Admins dürfen sensible Felder NICHT anfassen —
    // insbesondere nicht den Umrechnungskurs (Auszahlungswert!), den Testmodus,
    // Jackpot/Hausbank oder den WhatsApp-Link.
    match /appState/{doc} {
      allow read: if true;
      allow write: if isAdmin()
        || (request.auth != null
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'jackpot', 'currentMatchday', 'hausbank',
                'testMode', 'exchangeRate', 'adminMessage', 'whatsappGroupLink'
              ]));
    }

    // ── Schedule: Server-only (Admin-SDK Import).
    match /schedule/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Feed ─────────────────────────────────────────────────────────────────
    // Lesen für alle authed. Feed-Einträge schreiben nur Server-Endpoints
    // (purchase-shop-item, resolve-market, jackpot-Distribution usw.).
    match /feed/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Auto-deductions audit: nur lesen (Server schreibt via Admin-SDK).
    match /autoDeductions/{deductionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Jackpot-Bewegungslog (Diagnose): jede Hausbank-/Jackpot-Änderung mit
    // Grund. Lesen für authed (Admin-Diagnose). Automatische Einträge schreibt
    // der Server (Admin-SDK, umgeht Rules); manuelle Jackpot-Korrekturen darf der
    // Admin-Client anhängen (create). Bestehende Einträge bleiben unveränderbar.
    match /jackpotLedger/{entryId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Bet-Changes audit: revisionssicheres Log der Wett-Änderungen. Nur lesen
    // (Admin-Token-Historie); geschrieben ausschliesslich vom Server (change-bet
    // via Admin-SDK). Kein Client-Write, damit niemand Audit-Spuren faelscht.
    match /betChanges/{changeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Shop-Items ───────────────────────────────────────────────────────────
    // Lesen für alle authed. Katalog-Pflege NUR durch Admins; zusätzlich darf
    // selbst der Admin-Client das `sold`-Feld (Stock-Bookkeeping) nicht ändern —
    // das inkrementiert ausschliesslich der Server (purchase-shop-item). Damit
    // kann niemand mehr einen Item-Preis auf 0 setzen und gratis „kaufen".
    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && (resource == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sold']));
    }

    // ── Default-Deny (Defense-in-Depth): alles Nicht-Gematchte ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
