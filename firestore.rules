rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players: lesen für alle authed. create/update/delete nur auf der eigenen
    // Doc oder bei Test-Spielern (Admin verwaltet sie clientseitig). Vorher war
    // update offen für jeden authed — damit konnte jeder Spieler fremde Token-
    // Stände und isAdmin-Flags überschreiben.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.auth.uid == playerId || request.resource.data.isTestPlayer == true);
      allow update: if request.auth != null
        && (request.auth.uid == playerId || resource.data.isTestPlayer == true);
      allow delete: if request.auth != null
        && (request.auth.uid == playerId || resource.data.isTestPlayer == true);
    }

    // Usernames: eindeutige Namens-Reservierung (Doc-ID = slug des Namens).
    // Wird in einer Transaction bei der Registrierung gesetzt → echte
    // Eindeutigkeit ohne Race. Jeder darf lesen (Prüfung), aber nur ein Doc
    // mit der eigenen uid anlegen. Löschen erlaubt (Reset/Kick via Admin-SDK).
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // Markets: any authenticated user can read and write (admin creates/resolves).
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bets: private app — any authenticated user can create and delete bets.
    // Allows admin to place bets on behalf of test players and to bulk-delete
    // during reset. The invite-code registration gate is the security perimeter.
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Answers: same reasoning as bets (delete needed for reset).
    match /answers/{answerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // App state: invite code readable without auth (needed for registration gate).
    match /appState/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Schedule: WM 2026 fixtures (written by Netlify Functions via Admin SDK).
    match /schedule/{matchId} {
      allow read: if request.auth != null;
    }

    // Feed: authenticated users can read; write needed for admin reset.
    match /feed/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Auto-deductions audit: read-only for authenticated users.
    match /autoDeductions/{deductionId} {
      allow read: if request.auth != null;
    }

    // Shop-Items: jeder authentifizierte Spieler liest den Katalog. Schreiben ist
    // serverseitig (Firestore-Transaction beim Kauf) bzw. UI-seitig (Admin) auf
    // PIN-gegateten Admin-Flow beschränkt — derselbe Trust-Level wie bei
    // markets/bets im aktuellen Spielstand.
    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
