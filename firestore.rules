rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players: authenticated user can read all, write only their own doc
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == playerId;
      allow update: if request.auth != null && request.auth.uid == playerId;
    }

    // Markets: any authenticated user can read; only Cloud Functions write
    // (In dev, allow admin writes from client by checking createdBy == 'admin')
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bets: authenticated users can read all bets on a market (for distribution view);
    // can only create bets for themselves
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.playerId == request.auth.uid;
    }

    // Answers: same as bets
    match /answers/{answerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.playerId == request.auth.uid;
    }

    // App state: read-only for authenticated users
    match /appState/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Feed: read-only for authenticated users
    match /feed/{eventId} {
      allow read: if request.auth != null;
    }

    // Auto-deductions audit: read-only for authenticated users
    match /autoDeductions/{deductionId} {
      allow read: if request.auth != null;
    }
  }
}
